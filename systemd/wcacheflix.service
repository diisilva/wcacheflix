[Unit]
Description=wcacheflix Jellyfin
Requires=docker.service
After=docker.service
# Não sobe o Jellyfin se a partição de mídia não estiver montada.
# Isso impede que o container grave silenciosamente no SSD.
RequiresMountsFor=/srv/wcacheflix

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/wcacheflix
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
