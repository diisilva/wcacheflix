# Copie para .env e ajuste, ou gere automaticamente com:
#   ./scripts/05-generate-env.sh
#
# PUID / PGID: id numérico do seu usuário e grupo (saída de `id -u` e `id -g`).
# RENDER_GID : grupo do dispositivo /dev/dri/renderD128
#              (saída de `stat -c '%g' /dev/dri/renderD128`).
#              Deixe vazio e remova o bloco "devices" do compose.yaml se a
#              máquina não tiver GPU compatível.

PUID=1000
PGID=1000
RENDER_GID=110
